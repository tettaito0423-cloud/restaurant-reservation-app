// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DinnerSlot {
  id          Int    @id @default(autoincrement())
  startAt      DateTime

  meals         Meal[]
}

model Reservation {
  id                  Int   @id @default(autoincrement())
  roomNumber          String
  adultCount          Int
  childMealCount      Int
  childNoMealCount    Int
  checkin             DateTime
  checkout            DateTime
  dietaryRestrictions String
  comment             String

  stays               Stay[]
}

model Stay {
  id            Int   @id @default(autoincrement())
  reservationId Int
  date          DateTime

  reservation   Reservation @relation(fields: [reservationId], references: [id])
  meals         Meal[]
}

model Meal {
  id            Int   @id @default(autoincrement())
  stayId        Int
  mealType      MealType
  courseType    CourseType
  dinnerSlotId  Int

  stay          Stay @relation(fields: [stayId], references: [id])
  dinnerSlot    DinnerSlot? @relation(fields: [dinnerSlotId], references: [id])
}

enum MealType {
  DINNER
  BREAKFAST
}


enum CourseType{
  FULL
  HALF
}